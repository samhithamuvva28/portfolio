---
import Section from "./Section.astro";
import referuLogo from "../assets/referuai_logo.jpg";
import tectoroLogo from "../assets/tectoro.png";
import dxcLogo from "../assets/DXC_Technology.png";
import fiservLogo from "../assets/Fiserv.png";

import awsLogo from "../assets/AWS.png";
import gSuiteLogo from "../assets/G-Suite.png";
import powerbiLogo from "../assets/powerbi.jpg";

const slugMap = {
  React: "react",
  "Node.js": "nodedotjs",
  PostgreSQL: "postgresql",
  PostGreSQL: "postgresql",
  Python: "python",
  FastAPI: "fastapi",
  Docker: "docker",
  Docer: "docker",
  Astro: "astro",
  Tailwind: "tailwindcss",
  TypeScript: "typescript",
  "Apache Spark": "apachespark",
  Databricks: "databricks",
  AWS: "amazonaws",
  Weaviate: "weaviate",
  NumPy: "numpy",
  Pandas: "pandas",
  BigQuery: "googlebigquery",
  Tableau: "tableau",
  Java: "java",
  "Apache Hive": "apachehive",
  Notion: "notion",
  GSuite: "googleworkspace",
  Gsuite: "googleworkspace",
  "G Suite": "googleworkspace",
  PowerBI: "powerbi",
  "Power BI": "powerbi",
  "C++": "cplusplus",
  Bash: "gnubash",
  Linux: "linux",
  Qdrant: "qdrant",
  Azure: "microsoftazure",
};

const iconUrl = (name: string) => {
  const local: Record<string, string> = {
    AWS: awsLogo.src,
    PowerBI: powerbiLogo.src,
    "Power BI": powerbiLogo.src,
    Gsuite: gSuiteLogo.src,
    GSuite: gSuiteLogo.src,
    "G Suite": gSuiteLogo.src,
    "Google Workspace": gSuiteLogo.src,
  };
  if (local[name]) return local[name];
  const devicons: Record<string, string> = {
    Java: "https://cdn.jsdelivr.net/gh/devicons/devicon/icons/java/java-original.svg",
  };
  return devicons[name] ?? `https://cdn.simpleicons.org/${slugMap[name] ?? name.toLowerCase()}`;
};

const stacks = {
  referu: ["PostgreSQL", "FastAPI", "Python", "Docker", "Qdrant", "Gsuite", "Notion"],
  tectoro: ["Azure", "Azure Data Factory", "Azure Synapse", "Azure Blob Storage", "Python", "Pandas", "NumPy", "PowerBI"],
  dxc: ["C++", "Bash", "Linux"],
  fiserv: ["Apache Hive", "Java"],
};
---
<Section id="work" title="Where I’ve Worked">
  <div class="mt-4 mx-auto max-w-3xl space-y-6">
    <a href="https://referu.ai/" target="_blank" rel="noopener noreferrer" class="group block rounded-xl border border-[#D8F1E3] bg-[#EEF7F1] p-4 md:p-5 shadow-sm transition-colors hover:bg-white hover:shadow-md transform transition-transform duration-300 will-change-transform hover:scale-[1.03] hover:-translate-y-0.5">
      <div class="flex items-start gap-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:scale-[1.01]">
        <img src={referuLogo.src} width={referuLogo.width} height={referuLogo.height} alt="ReferU.AI logo" class="h-12 w-12 rounded-sm object-contain bg-white" loading="lazy" decoding="async" />
        <div>
          <h3 class="text-base md:text-lg font-semibold text-zinc-900 flex items-center gap-2">AI Engineer (GenAI Systems / Backend) · ReferU.AI
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" class="text-zinc-500 transition-transform group-hover:text-[#15543c] group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </h3>
          <div class="text-xs md:text-sm text-zinc-600">Remote, USA · Jun 2025–Present</div>
          <ul class="mt-2 list-disc pl-5 space-y-1 text-zinc-700">
            <li>Designed and shipped LLM workflows using multi-agent architecture (CrewAI + LangGraph) for legal intake analysis, clause retrieval, and document generation across 58+ jurisdictions.</li>
            <li>Developed agent modules (retrieval, compliance validation, drafting, revision routing) coordinating controlled tool use via structured reasoning and shared state isolation.</li>
            <li>Implemented a production tool execution layer (MCP-style) with schema validation, authentication, rate limiting, retries, and safe fallbacks.</li>
            <li>Built backend orchestration services in FastAPI with PostgreSQL-backed state for sessions, config versioning, and storage of document metadata and execution traces.</li>
            <li>Engineered a hybrid RAG system using Qdrant with metadata-aware indexing and structured chunking for grounded, explainable retrieval.</li>
            <li>Worked with GitHub workflows: PR reviews, branching/versioning, and CI validation.</li>
            <li>Built unit and integration tests for agent pipelines, API endpoints, and retrieval workflows.</li>
            <li>Implemented monitoring and evaluation pipelines (policy checks, structured metrics), reducing non-compliant responses by 27%.</li>
          </ul>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {stacks.referu.sort().map((t) => (
              <span class="inline-flex items-center gap-1 rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700">
                {slugMap[t] && (
                  <img src={iconUrl(t)} data-fallback={`https://cdn.simpleicons.org/${slugMap[t] ?? t.toLowerCase()}`} onerror="this.onerror=null; if(this.dataset.fallback) this.src=this.dataset.fallback" alt={`${t} logo`} width="20" height="20" class="inline-block h-5 w-5 align-middle object-contain shrink-0" loading="lazy" decoding="async" />
                )}
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>
    </a>

    <a href="https://www.tectoro.com/" target="_blank" rel="noopener noreferrer" class="group block rounded-xl border border-[#D8F1E3] bg-[#EEF7F1] p-4 md:p-5 shadow-sm transition-colors hover:bg-white hover:shadow-md transform transition-transform duration-300 will-change-transform hover:scale-[1.03] hover:-translate-y-0.5">
      <div class="flex items-start gap-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:scale-[1.01]">
        <img src={tectoroLogo.src} width={tectoroLogo.width} height={tectoroLogo.height} alt="Tectoro logo" class="h-12 w-12 rounded-sm object-contain bg-white" loading="lazy" decoding="async" />
        <div>
          <h3 class="text-base md:text-lg font-semibold text-zinc-900 flex items-center gap-2">AI Engineer · Tectoro (Healthcare Division)
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" class="text-zinc-500 transition-transform group-hover:text-[#15543c] group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </h3>
          <div class="text-xs md:text-sm text-zinc-600">Hyderabad, India · Oct 2022–Nov 2023</div>
          <ul class="mt-2 list-disc pl-5 space-y-1 text-zinc-700">
            <li>Designed and maintained production ML pipelines on Azure Data Factory, Blob Storage, and Azure Synapse, processing 2M+ healthcare records.</li>
            <li>Architected distributed transformations with partitioning and tuned joins, improving efficiency by 28% and reducing end-to-end bottlenecks.</li>
            <li>Implemented lifecycle governance with drift detection and rollback, reducing model degradation by 35%.</li>
          </ul>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {stacks.tectoro.sort().map((t) => (
              <span class="inline-flex items-center gap-1 rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700">
                {slugMap[t] && (
                  <img src={iconUrl(t)} data-fallback={`https://cdn.simpleicons.org/${slugMap[t] ?? t.toLowerCase()}`} onerror="this.onerror=null; if(this.dataset.fallback) this.src=this.dataset.fallback" alt={`${t} logo`} width="20" height="20" class="inline-block h-5 w-5 align-middle object-contain shrink-0" loading="lazy" decoding="async" />
                )}
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>
    </a>

    <a href="https://dxc.com/" target="_blank" rel="noopener noreferrer" class="group block rounded-xl border border-[#D8F1E3] bg-[#EEF7F1] p-4 md:p-5 shadow-sm transition-colors hover:bg-white hover:shadow-md transform transition-transform duration-300 will-change-transform hover:scale-[1.03] hover:-translate-y-0.5">
      <div class="flex items-start gap-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:scale-[1.01]">
        <img src={dxcLogo.src} width={dxcLogo.width} height={dxcLogo.height} alt="DXC Technology logo" class="h-12 w-12 rounded-sm object-contain bg-white" loading="lazy" decoding="async" />
        <div>
          <h3 class="text-base md:text-lg font-semibold text-zinc-900 flex items-center gap-2">Software Engineer Intern · DXC Technology
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" class="text-zinc-500 transition-transform group-hover:text-[#15543c] group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </h3>
          <div class="text-xs md:text-sm text-zinc-600">India · Nov 2019–Jan 2020</div>
          <ul class="mt-2 list-disc pl-5 space-y-1 text-zinc-700">
            <li>Developed high-throughput backend components in C++ for distributed telemetry log processing under high concurrency.</li>
            <li>Optimized memory management and I/O patterns, reducing processing latency by 20% and strengthening reliability.</li>
          </ul>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {stacks.dxc.sort().map((t) => (
              <span class="inline-flex items-center gap-1 rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700">
                {slugMap[t] && (
                  <img src={iconUrl(t)} data-fallback={`https://cdn.simpleicons.org/${slugMap[t] ?? t.toLowerCase()}`} onerror="this.onerror=null; if(this.dataset.fallback) this.src=this.dataset.fallback" alt={`${t} logo`} width="20" height="20" class="inline-block h-5 w-5 align-middle object-contain shrink-0" loading="lazy" decoding="async" />
                )}
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>
    </a>

    <a href="https://www.fiserv.com/en.html" target="_blank" rel="noopener noreferrer" class="group block rounded-xl border border-[#D8F1E3] bg-[#EEF7F1] p-4 md:p-5 shadow-sm transition-colors hover:bg-white hover:shadow-md transform transition-transform duration-300 will-change-transform hover:scale-[1.03] hover:-translate-y-0.5">
      <div class="flex items-start gap-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:scale-[1.01]">
        <img src={fiservLogo.src} width={fiservLogo.width} height={fiservLogo.height} alt="Fiserv logo" class="h-12 w-12 rounded-sm object-contain bg-white" loading="lazy" decoding="async" />
        <div>
          <h3 class="text-base md:text-lg font-semibold text-zinc-900 flex items-center gap-2">Software Engineer Intern · Fiserv
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" class="text-zinc-500 transition-transform group-hover:text-[#15543c] group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7"/><path d="M7 7h10v10"/></svg>
          </h3>
          <div class="text-xs md:text-sm text-zinc-600">Chennai, India · July 2022-Sep 2022</div>
          <ul class="mt-2 list-disc pl-5 space-y-1 text-zinc-700">
            <li>Supported development of data-monitoring and anomaly-detection pipelines for enterprise infrastructure logs, enabling early identification of service-level deviations.</li>
            <li>Conducted root-cause analysis on incident patterns to enhance model explainability and improve alert precision by 8%.</li>
            <li>Automated data ingestion workflows in Hive + Java, improving operational analytics throughput by 35%.</li>
          </ul>
          <div class="mt-3 flex flex-wrap items-center gap-2">
            {stacks.fiserv.sort().map((t) => (
              <span class="inline-flex items-center gap-1 rounded-md bg-zinc-100 px-2 py-0.5 text-xs text-zinc-700">
                {slugMap[t] && (
                  <img src={iconUrl(t)} data-fallback={`https://cdn.simpleicons.org/${slugMap[t] ?? t.toLowerCase()}`} onerror="this.onerror=null; if(this.dataset.fallback) this.src=this.dataset.fallback" alt={`${t} logo`} width="20" height="20" class="inline-block h-5 w-5 align-middle object-contain shrink-0" loading="lazy" decoding="async" />
                )}
                {t}
              </span>
            ))}
          </div>
        </div>
      </div>
    </a>
  </div>
</Section>
